<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/dois"
    tools:context=".Activity_edita_pet">

    <TextView
        android:id="@+id/tv_title_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:layout_marginBottom="13dp"
        android:textColor="@color/gray"
        android:text="Editar Dados do Pet"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/edit_nome"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="16dp" />

    <EditText
        android:id="@+id/edit_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Nome do Pet"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_edit"
        tools:layout_editor_absoluteX="39dp" />

    <Spinner
        android:id="@+id/spinner_especie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/gray_border"
        android:entries="@array/pet_species_array"
        app:layout_constraintBottom_toTopOf="@+id/edit_descricao"
        app:layout_constraintTop_toBottomOf="@+id/edit_data_nasc"
        tools:layout_editor_absoluteX="3dp" />

    <EditText
        android:id="@+id/edit_data_nasc"
        android:layout_width="381dp"
        android:layout_height="64dp"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="24dp"
        android:hint="Data de Nascimento"
        android:inputType="date"
        android:minHeight="48dp"
        app:layout_constraintBottom_toTopOf="@+id/spinner_especie"
        app:layout_constraintTop_toBottomOf="@+id/edit_nome"
        tools:layout_editor_absoluteX="-2dp" />

    <EditText
        android:id="@+id/edit_descricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="104dp"
        android:hint="Descrição ou Notas Adicionais"
        android:inputType="textMultiLine"
        android:minHeight="48dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_salvar_edicao"
        app:layout_constraintTop_toBottomOf="@+id/spinner_especie"
        tools:layout_editor_absoluteX="3dp" />

    <Button
        android:id="@+id/btn_salvar_edicao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Salvar Alterações"
        app:layout_constraintTop_toBottomOf="@id/edit_descricao"
        tools:layout_editor_absoluteX="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>