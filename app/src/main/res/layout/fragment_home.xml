<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".fragment_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
        android:id="@+id/tv_home_saudacao"
        android:layout_marginTop="55dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#133566"
        android:layout_marginBottom="32dp"
        tools:text="Olá, Usuário!" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_next_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#133566">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANIVERSÁRIO MAIS PRÓXIMO"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tv_proximo_evento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#F6E58D" android:layout_marginTop="8dp"
                tools:text="🐶 Aniversário do Max em 30 dias!" />
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seus Pets Cadastrados"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3C6E97" android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_pet_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#666666" android:layout_marginBottom="24dp"
            tools:text="Você está cuidando de 2 pet(s)." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acesso Rápido"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#8FA3BC"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="1"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_reminder_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="12dp"
                android:text="Lembrete"
                android:paddingVertical="16dp"
                android:textColor="#133566"
                app:iconTint="#133566"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#5985C1"
                app:cornerRadius="12dp" />

        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lembretes Pendentes"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3C6E97"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <TextView
                android:id="@+id/tv_next_reminder_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ainda não implementamos a função de lembretes, mas aqui você verá:\n- Vacina V8 do Max (Amanhã)\n- Banho da Luna (Quarta)"
                android:textSize="16sp"
                android:textColor="#333333"/>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Dica Rápida do Dia"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E06D28"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#333333"
                android:text="Lembre-se: O olfato do seu cão é seu sentido mais poderoso. Passeie com ele em novos lugares para enriquecer a experiência sensorial!" />
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="50dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>